# backend/.env 로 복사해서 값을 채운다. .env는 .gitignore에 있어 커밋되지 않는다.
# application.properties가 spring.config.import로 이 파일을 자동으로 읽는다.

# 로컬 MySQL. 스키마는 Flyway가 만든다.
DB_URL=jdbc:mysql://localhost:3306/wakebook
DB_USERNAME=root
DB_PASSWORD=

# JWT 서명 키. 32바이트 이상의 임의 문자열이어야 한다.
JWT_SECRET=

# 정보나루(도서관 정보나루) 인증키. https://data4library.kr
# 대출 순위·장서 목록·소장 도서관은 이 API로만 얻을 수 있어 필수다.
# 마이페이지에서 개발 PC IP를 등록하지 않으면 하루 500건에서 막힌다.
DATA4LIBRARY_API_KEY=

# 알라딘 TTB 키. https://www.aladin.co.kr/ttb/wblog_manage.aspx
# 도서 상세(서지·소개글)의 1차 소스라, 없으면 그 호출이 전부 정보나루로 넘어가 한도를 빠르게 소진한다.
ALADIN_TTB_KEY=

# 카카오 책 검색 REST API 키. ISBN 상세 조회의 1차 공급자다.
KAKAO_API_KEY=

# OpenAI. 추천 이유·키워드 생성에 쓴다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 네이버 개발자센터 애플리케이션에서 발급받은 인증 정보. 별도 제휴 계약은 필요하지 않다.
# 비워 두면 Google Trends와 AI 추천은 동작하고, NAVER 뉴스/검색 추이 검증은 UNVERIFIED로 처리된다.
# 네이버 개발자센터에서 "검색"과 "데이터랩"을 추가한 애플리케이션의 비로그인 Open API 키
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 일일 트렌드 추천 스케줄(기본: 매일 KST 05:00)과 수동 재생성 제한
TREND_SCHEDULER_ENABLED=true
TREND_SCHEDULE_CRON=0 0 5 * * *
TREND_REFRESH_COOLDOWN_MINUTES=30

# 잠자는 도서는 KDC 10개 대분류를 가능한 한 균등하게 채운다.
HIDDEN_BOOK_POOL_SIZE=200

# 전용 MySQL 검증 DB. 실사용 DB를 보호하기 위해 데이터베이스 이름은 반드시 _test로 끝내야 한다.
MYSQL_TEST_URL=jdbc:mysql://localhost:3306/wakebook_mysql_test
MYSQL_TEST_USERNAME=root
MYSQL_TEST_PASSWORD=
EXTERNAL_TEST_DB_URL=jdbc:mysql://localhost:3306/wakebook_external_test
EXTERNAL_TEST_DB_USERNAME=root
EXTERNAL_TEST_DB_PASSWORD=
